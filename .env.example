# ============================================================
# DiagoLAB Raporty+ — przykładowa konfiguracja środowiska
# Skopiuj do .env:  cp .env.example .env   (plik .env jest w .gitignore!)
# ============================================================

# --- WYMAGANE ---
# Połączenie z PostgreSQL (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db

# Publiczny adres aplikacji (linki QR w raportach, metadane)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sekret HMAC linków udostępniania raportów — wymagany na produkcji.
# Wygeneruj np.: openssl rand -hex 32
SHARE_TOKEN_SECRET=

# --- OPCJONALNE: Moduł B (AI) ---
# Bez klucza endpoint /api/ai-summary działa w trybie regułowym (deterministycznym)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- OPCJONALNE: wysyłka kodów weryfikacyjnych ---
# Bez konfiguracji kody e-mail/SMS są zwracane w odpowiedzi API z flagą DEV
SMTP_URL=
SMS_PROVIDER_KEY=

# --- OPCJONALNE: płatności Stripe ---
# Bez konfiguracji aktywacja pakietów działa w trybie symulacji DEV.
# Panel Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- OPCJONALNE: nadawca e-mail ---
SMTP_FROM=DiagoLAB Raporty+ <noreply@diagolab.pl>
