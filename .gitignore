# ============================================================
# DiagoLAB Raporty+ — .gitignore
# Next.js · Node · TypeScript · Drizzle · Vitest · Playwright
# ============================================================

# ---------- Zależności ----------
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Sekrety i środowisko ----------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example
*.pem
*.key
*.p12
*.pfx
.secrets/

# ---------- Next.js ----------
.next/
out/
next-env.d.ts
.vercel/
swr/

# ---------- Build / TypeScript ----------
dist/
build/
*.tsbuildinfo
eslintcache
.eslintcache
.stylelintcache

# ---------- Testy ----------
coverage/
.coverage/
*.lcov
test-results/
playwright-report/
blob-report/
junit.xml
.nyc_output/

# ---------- Cache narzędzi ----------
.cache/
.turbo/
.swc/
.vitest/
.playwright/
.fleet/

# ---------- Logi ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Runtime / procesy ----------
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.bak
*.swp
*.swo

# ---------- System operacyjny ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- Edytory ----------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace

# ---------- Lokalne skrypty debugowe (jednorazowe) ----------
dbg*.mjs
debug-*.mjs

# ---------- Artefakty E2E/CI lokalne ----------
# (raporty Playwright obsłużone wyżej; tu lokalne zrzuty/debug)
trace.zip
